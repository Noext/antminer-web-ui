# Antminer API Configuration
ANTMINER_HOST=http://192.168.xxx.xxx
ANTMINER_USERNAME=YOUR_USER
ANTMINER_PASSWORD=YOUR_PASSWORD

# Security - Change this to a random string in production
# Generate with: openssl rand -base64 32
API_SECRET_KEY=A_RANDOM_KEY

# Optional: require Authorization: Bearer <value> on /mcp.
MCP_API_KEY=

# Optional comma-separated browser origins allowed to call /mcp.
# Requests without Origin (normal server-side MCP clients) remain allowed.
MCP_ALLOWED_ORIGINS=

# Optional Android/Web Push monitoring. Generate the key pair with:
# npx web-push generate-vapid-keys
MINER_MONITOR_ENABLED=false
MINER_MONITOR_INTERVAL_MS=30000
MINER_MONITOR_FAILURE_THRESHOLD=3
ANTMINER_REQUEST_TIMEOUT_MS=10000
PUSH_DATA_DIR=.data
VAPID_SUBJECT=https://github.com/Noext/antminer-web-ui
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Public HTTPS origin used to validate browser mutation requests behind a proxy.
APP_ORIGIN=https://antminer.example.com
